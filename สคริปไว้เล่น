-- ระบบ Auto Farm เหรียญ (Tween Safe)
-- ==========================================
local function safeTweenMove(targetCFrame, speed)
	speed = speed or 32
	local char = player.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local root = char.HumanoidRootPart

	local dist = (root.Position - targetCFrame.Position).Magnitude
	local duration = math.clamp(dist / speed, 0.1, 2.5)

	local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
	local tween = TweenService:Create(root, tweenInfo, {CFrame = targetCFrame})
	tween:Play()
	tween.Completed:Wait()
end

local function getMapCoins()
	local coins = {}
	for _, model in pairs(Workspace:GetChildren()) do
		local coinContainer = model:FindFirstChild("CoinContainer") or model:FindFirstChild("Coins")
		if coinContainer then
			for _, coin in pairs(coinContainer:GetChildren()) do
				if coin:IsA("BasePart") and coin.Transparency < 1 then
					table.insert(coins, coin)
				end
			end
		end
	end
	return coins
end

local autoFarm = false
task.spawn(function()
	while task.wait(0.2) do
		if autoFarm and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local coins = getMapCoins()
			for _, coin in ipairs(coins) do
				if not autoFarm then break end
				if coin and coin.Parent and coin.Transparency < 1 then
					safeTweenMove(coin.CFrame + Vector3.new(0, 1.5, 0), 35)
					task.wait(0.05)
				end
			end
		end
	end
end)

