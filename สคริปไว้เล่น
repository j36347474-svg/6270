-- 5. ระบบ ESP (Instant Role Detection - แก้ไร้คูลดาวน์)
-- ==========================================
local function getPlayerRole(targetPlayer)
	if not targetPlayer or not targetPlayer.Character then return "Innocent" end
	local char = targetPlayer.Character
	local backpack = targetPlayer:FindFirstChild("Backpack")

	if char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife")) then
		return "Murderer"
	elseif char:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun")) or char:FindFirstChild("Revolver") or (backpack and backpack:FindFirstChild("Revolver")) then
		return "Sheriff"
	end
	return "Innocent"
end

local function getMurderer()
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= player and getPlayerRole(p) == "Murderer" then
			return p
		end
	end
	return nil
end

local ROLE_COLORS = {
	Murderer = Color3.fromRGB(255, 30, 30),
	Sheriff  = Color3.fromRGB(0, 130, 255),
	Innocent = Color3.fromRGB(40, 220, 90)
}

local ROLE_NAMES = {
	Murderer = "ฆาตกร",
	Sheriff  = "นายอำเภอ",
	Innocent = "ผู้บริสุทธิ์"
}

local espEnabled = false
local playerEspObjects = {}
local gunEspObject = nil

local function removePlayerESP(p)
	if playerEspObjects[p] then
		if playerEspObjects[p].Highlight and playerEspObjects[p].Highlight.Parent then
			playerEspObjects[p].Highlight:Destroy()
		end
		if playerEspObjects[p].Billboard and playerEspObjects[p].Billboard.Parent then
			playerEspObjects[p].Billboard:Destroy()
		end
		playerEspObjects[p] = nil
	end
end

local function createPlayerESP(p)
	if not p or p == player then return end
	removePlayerESP(p)

	local char = p.Character
	if not char or not char:FindFirstChild("Head") or not char:FindFirstChild("HumanoidRootPart") then return end

	local hl = Instance.new("Highlight")
	hl.Name = "ESP_Highlight"
	hl.FillTransparency = 0.4
	hl.OutlineTransparency = 0.1
	hl.Parent = char

	local bbg = Instance.new("BillboardGui")
	bbg.Name = "ESP_Tag"
	bbg.AlwaysOnTop = true
	bbg.Size = UDim2.new(0, 160, 0, 40)
	bbg.StudsOffset = Vector3.new(0, 3, 0)
	bbg.Adornee = char.Head
	bbg.Parent = char

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, 0, 1, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.TextStrokeTransparency = 0.2
	nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	nameLabel.TextSize = 13
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.Parent = bbg

	playerEspObjects[p] = {Highlight = hl, Billboard = bbg, Label = nameLabel, Character = char}
end

local function setupInstantCheck(p)
	if p == player then return end

	local function onCharAdded(char)
		if espEnabled then
			createPlayerESP(p)
		end
		
		char.ChildAdded:Connect(function()
			if espEnabled and playerEspObjects[p] then
				task.wait()
			end
		end)
	end

	if p.Character then
		onCharAdded(p.Character)
	end
	p.CharacterAdded:Connect(onCharAdded)

	local backpack = p:FindFirstChild("Backpack") or p:WaitForChild("Backpack", 5)
	if backpack then
		backpack.ChildAdded:Connect(function()
			if espEnabled and playerEspObjects[p] then
				task.wait()
			end
		end)
	end
end

for _, p in pairs(Players:GetPlayers()) do
	setupInstantCheck(p)
end

Players.PlayerAdded:Connect(setupInstantCheck)
Players.PlayerRemoving:Connect(removePlayerESP)

RunService.RenderStepped:Connect(function()
	if espEnabled then
		for _, p in pairs(Players:GetPlayers()) do
			if p ~= player then
				local char = p.Character
				if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Head") then
					if not playerEspObjects[p] or playerEspObjects[p].Character ~= char or not playerEspObjects[p].Highlight.Parent then
						createPlayerESP(p)
					end

					local esp = playerEspObjects[p]
					if esp and esp.Highlight and esp.Label and esp.Highlight.Parent then
						local role = getPlayerRole(p)
						local color = ROLE_COLORS[role] or ROLE_COLORS.Innocent
						local roleTitle = ROLE_NAMES[role] or "ผู้บริสุทธิ์"

						esp.Highlight.FillColor = color
						esp.Highlight.OutlineColor = color
						esp.Label.TextColor3 = color

						local distance = math.floor((char.HumanoidRootPart.Position - Workspace.CurrentCamera.CFrame.Position).Magnitude)
						esp.Label.Text = string.format("%s\n[%s] (%dm)", p.DisplayName or p.Name, roleTitle, distance)
					end
				else
					removePlayerESP(p)
				end
			end
		end

		local gunDrop = Workspace:FindFirstChild("GunDrop", true)
		if gunDrop and gunDrop:IsA("BasePart") then
			if not gunEspObject or gunEspObject.Part ~= gunDrop or not gunEspObject.Highlight.Parent then
				if gunEspObject then
					if gunEspObject.Highlight then gunEspObject.Highlight:Destroy() end
					if gunEspObject.Billboard then gunEspObject.Billboard:Destroy() end
				end

				local hl = Instance.new("Highlight")
				hl.FillTransparency = 0.25
				hl.FillColor = Color3.fromRGB(255, 255, 0)
				hl.OutlineColor = Color3.fromRGB(255, 255, 0)
				hl.Parent = gunDrop

				local bbg = Instance.new("BillboardGui")
				bbg.Name = "GunDrop_ESP"
				bbg.AlwaysOnTop = true
				bbg.Size = UDim2.new(0, 160, 0, 35)
				bbg.StudsOffset = Vector3.new(0, 2, 0)
				bbg.Adornee = gunDrop
				bbg.Parent = gunDrop

				local label = Instance.new("TextLabel")
				label.Size = UDim2.new(1, 0, 1, 0)
				label.BackgroundTransparency = 1
				label.TextColor3 = Color3.fromRGB(255, 255, 0)
				label.TextStrokeTransparency = 0.1
				label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
				label.TextSize = 14
				label.Font = Enum.Font.GothamBold
				label.Text = "🔫 ปืนตกอยู่ที่นี่!"
				label.Parent = bbg

				gunEspObject = {Highlight = hl, Billboard = bbg, Part = gunDrop}
			end
		else
			if gunEspObject then
				if gunEspObject.Highlight then gunEspObject.Highlight:Destroy() end
				if gunEspObject.Billboard then gunEspObject.Billboard:Destroy() end
				gunEspObject = nil
