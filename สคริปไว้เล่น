local function createRainbowGradient(parent)
	local uiGradient = Instance.new("UIGradient")
	uiGradient.Name = "RainbowGradient"
	uiGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 128)),
		ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 100, 0)),
		ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 230, 0)),
		ColorSequenceKeypoint.new(0.6, Color3.fromRGB(0, 255, 150)),
		ColorSequenceKeypoint.new(0.8, Color3.fromRGB(0, 180, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(180, 0, 255))
	})
	uiGradient.Parent = parent
	return uiGradient
end

local function animateRainbow(uiGradient, speed)
	speed = speed or 1
	RunService.RenderStepped:Connect(function()
		local offset = (tick() * speed) % 1
		if uiGradient and uiGradient.Parent then
			uiGradient.Offset = Vector2.new(offset, 0)
		end
	end)
end

